name: keepalive
on:
  schedule:
    - cron: "0 6 1 * *"
  workflow_dispatch:
permissions:
  contents: write
jobs:
  keepalive:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - run: |
          git config user.name "agent-bot"
          git config user.email "agent-bot@users.noreply.github.com"
          git commit --allow-empty -m "keepalive $(date -u +%F)"
          git push
